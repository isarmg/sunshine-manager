[Unit]
Description=Sunshine Manager
ConditionArchitecture=x86-64
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=isarmg-sunshine
Group=isarmg-sunshine
EnvironmentFile=/etc/isarmg/sunshine-manager.env
Environment=SUNSHINE_MANAGER_STATIC_DIR=/opt/isarmg/sunshine-manager/releases/0.7.0/web
ExecStart=/opt/isarmg/sunshine-manager/releases/0.7.0/bin/sunshine-manager serve-release --root /opt/isarmg/sunshine-manager/releases/0.7.0
StateDirectory=isarmg/sunshine-manager/db
StateDirectoryMode=0700
RuntimeDirectory=isarmg/sunshine-manager
RuntimeDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectProc=invisible
ProcSubset=pid
RemoveIPC=true
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
