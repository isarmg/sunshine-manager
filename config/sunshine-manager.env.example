# Sunshine Manager 当前运行配置模板。
# 复制到 /etc/isarmg/sunshine-manager.env 后，替换密钥和管理员密码，并保持文件权限 0600。
SUNSHINE_MANAGER_DATABASE_URL=sqlite:///var/lib/isarmg/sunshine-manager/db/sunshine-manager.sqlite3
SUNSHINE_MANAGER_STATIC_DIR=/opt/isarmg/sunshine-manager/releases/0.7.0/web
SUNSHINE_MANAGER_BIND=127.0.0.1:18104
SUNSHINE_MANAGER_PRODUCTION=true

# 必须是恰好 32 bytes 的标准 Base64；这里的占位文本会被启动校验拒绝。
SUNSHINE_MANAGER_CREDENTIAL_KEY=REPLACE_WITH_STANDARD_BASE64_FOR_EXACTLY_32_RANDOM_BYTES
SUNSHINE_MANAGER_CREDENTIAL_KEY_ID=primary

SUNSHINE_MANAGER_BOOTSTRAP_ADMIN_USERNAME=admin
SUNSHINE_MANAGER_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD_OF_AT_LEAST_12_BYTES

SUNSHINE_MANAGER_SESSION_TTL_SECONDS=43200
SUNSHINE_MANAGER_SESSION_IDLE_TTL_SECONDS=1800
SUNSHINE_MANAGER_SESSION_COOKIE_SECURE=true

# 留空表示禁用封面上传。启用时只列小写 DNS 主机名，并同时配置 HTTPS 代理 origin。
SUNSHINE_MANAGER_COVER_URL_ALLOWLIST=
# SUNSHINE_MANAGER_COVER_PROXY_ORIGIN=https://cover-proxy.example.com
